---
# Identidade do WinRise Connect OS no instalador Calamares
componentName:  winrise
welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 900px,620px
windowPlacement: center

strings:
    productName:         "WinRise Connect OS"
    shortProductName:    "WinRise"
    version:             "0.2"
    shortVersion:        "0.2"
    versionedName:       "WinRise Connect OS 0.2"
    shortVersionedName:  "WinRise Connect 0.2"
    bootloaderEntryName: "WinRise"
    productUrl:          "https://github.com/wglebioravel/winrise-connect-os"
    supportUrl:          "https://github.com/wglebioravel/winrise-connect-os/issues"
    knownIssuesUrl:      "https://github.com/wglebioravel/winrise-connect-os/issues"
    releaseNotesUrl:     "https://github.com/wglebioravel/winrise-connect-os#readme"
    donateUrl:           ""

sidebar: widget
navigation: widget

images:
    productLogo:         "winrise-logo.png"
    productIcon:         "winrise-icon.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI:            2

style:
   SidebarBackground:        "#0b2550"
   SidebarText:              "#FFFFFF"
   SidebarTextCurrent:       "#FFFFFF"
   SidebarBackgroundCurrent: "#1f6fd1"
