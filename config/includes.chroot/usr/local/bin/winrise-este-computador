#!/bin/sh
# "Este Computador" do WinRise Connect OS: uma pasta com atalhos para as pastas do usuário e
# para os discos/pendrives montados, aberta no Dolphin. Ela aparece como um local
# ("Este Computador") na barra lateral, então a barra de endereço mostra só
# "Este Computador" em vez de um caminho técnico.
# Uso: winrise-este-computador [--refresh]   (--refresh só atualiza, sem abrir)
set -u
dir="$HOME/.local/share/winrise/Este Computador"
mkdir -p "$dir"
find "$dir" -mindepth 1 -maxdepth 1 -type l -delete 2>/dev/null
for k in DESKTOP DOCUMENTS DOWNLOAD PICTURES MUSIC VIDEOS; do
  p="$(xdg-user-dir "$k" 2>/dev/null)"
  [ -n "$p" ] && [ "$p" != "$HOME" ] && [ -d "$p" ] && ln -sfn "$p" "$dir/$(basename "$p")"
done
ln -sfn / "$dir/Disco Local (Sistema)"
for m in /media/"$USER"/* /run/media/"$USER"/*; do
  [ -d "$m" ] && ln -sfn "$m" "$dir/Disco $(basename "$m")"
done
[ "${1:-}" = "--refresh" ] && exit 0
exec dolphin --new-window "$dir"
