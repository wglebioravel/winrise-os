#!/bin/sh
# Abre um AppImage com duplo clique, como um .exe no Windows: marca como executável e roda.
f="$1"
[ -f "$f" ] || exit 1
if [ ! -x "$f" ]; then
  if kdialog --title "WinRise OS" --yesno "Executar o aplicativo \"$(basename "$f")\"?\n\nSó execute programas de fontes confiáveis."; then
    chmod +x "$f" || exit 1
  else
    exit 0
  fi
fi
"$f" || exec "$f" --appimage-extract-and-run
