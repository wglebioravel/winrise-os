#!/bin/sh
# Ajustes finos do WinRise Connect OS
set -e
FAVS="google-chrome.desktop,org.kde.dolphin.desktop,winrise-google-docs.desktop,winrise-google-sheets.desktop,winrise-google-gmail.desktop,winrise-este-computador.desktop,systemsettings.desktop,kcm_printer_manager.desktop,org.kde.discover.desktop,org.kde.plasma-systemmonitor.desktop,firefox-esr.desktop,org.kde.kate.desktop,org.kde.konsole.desktop"

# 1) Favoritos do menu Iniciar (padrão do Kickoff, vale para qualquer sessão nova)
K=/usr/share/plasma/plasmoids/org.kde.plasma.kickoff/contents/config/main.xml
if [ -f "$K" ]; then
  sed -i "s|<default>preferred://browser,org.kde.kontact.desktop,systemsettings.desktop,org.kde.dolphin.desktop,org.kde.discover.desktop</default>|<default>${FAVS}</default>|" "$K"
  grep -q "$FAVS" "$K" || echo "AVISO: favoritos do Kickoff não aplicados" >&2
fi

# 2) Ctrl+Shift+Esc abre o Monitor do Sistema (como o Gerenciador de Tarefas)
# O kglobalaccel do Plasma 6 lê a cópia em /usr/share/kglobalaccel; corrigir as duas.
for SM in /usr/share/applications/org.kde.plasma-systemmonitor.desktop \
          /usr/share/kglobalaccel/org.kde.plasma-systemmonitor.desktop; do
  [ -f "$SM" ] && sed -i 's/^X-KDE-Shortcuts=.*/X-KDE-Shortcuts=Ctrl+Shift+Esc,Meta+Esc/' "$SM"
done

# 3) Descrições de tipos de arquivo em pt-BR ("Pasta" em vez de "Folder")
python3 /usr/share/winrise/tools/mime-l10n.py pt_BR
update-mime-database /usr/share/mime

# 4) Instalador Calamares com a identidade do WinRise
if [ -f /etc/calamares/settings.conf ] && [ -d /etc/calamares/branding/winrise ]; then
  sed -i 's/^branding:.*/branding: winrise/' /etc/calamares/settings.conf
fi

# Windows XP/7: "Painel de Controle" como nome das Configurações do sistema
SS=/usr/share/applications/systemsettings.desktop
[ -f "$SS" ] && sed -i '0,/^Name\[pt_BR\]=.*/s//Name[pt_BR]=Painel de Controle/' "$SS"

# macOS (Spotlight): Win+S também abre a busca rápida (KRunner), além de Alt+Espaço
KR=/usr/share/kglobalaccel/org.kde.krunner.desktop
[ -f "$KR" ] && sed -i '0,/^X-KDE-Shortcuts=Alt+Space,/s//X-KDE-Shortcuts=Alt+Space,Meta+S,/' "$KR"

# Okular aparece no menu como "Leitor de PDF" (nome amigável, estilo Windows)
OK=/usr/share/applications/org.kde.okular.desktop
if [ -f "$OK" ]; then
  sed -i '0,/^Name\[pt_BR\]=.*/s//Name[pt_BR]=Leitor de PDF (Okular)/' "$OK"
  grep -q '^Name\[pt_BR\]=' "$OK" || sed -i '0,/^Name=.*/s//&\nName[pt_BR]=Leitor de PDF (Okular)/' "$OK"
fi
