#!/bin/sh
# Nomes do menu de boot (GRUB/UEFI e ISOLINUX/BIOS) com a marca WinRise Connect OS
set -e
for f in boot/grub/grub.cfg boot/grub/*.cfg; do
  [ -f "$f" ] || continue
  sed -i -e 's/menuentry "Live system ([^"]* fail-safe mode)"/menuentry "WinRise Connect OS (modo de segurança)"/' \
         -e 's/menuentry "Live system ([^"]*)"/menuentry "Iniciar o WinRise Connect OS (live)"/' \
         -e "s/submenu 'Utilities\.\.\.'/submenu 'Utilitários...'/" \
         -e "s/menuentry \"UEFI Firmware Settings\"/menuentry \"Configurações do firmware UEFI\"/" -e "s/menuentry \"Verify integrity of the boot medium\"/menuentry \"Verificar a integridade da mídia\"/" \
         -e "s/submenu .Advanced install options \.\.\.'/submenu 'Opções avançadas de instalação...'/" "$f"
done
if [ -f boot/grub/live-theme/theme.txt ]; then
  sed -i 's/^title-text: .*/title-text: ""/' boot/grub/live-theme/theme.txt
fi
for f in isolinux/*.cfg; do
  [ -f "$f" ] || continue
  sed -i -e 's/menu label ^Utilities/menu label ^Utilitarios/' -e 's/menu title Utilities/menu title Utilitarios/' \
         -e 's/menu title Boot menu/menu title Menu de inicializacao/' "$f"
done
